<?xml version="1.0" encoding="UTF-8"?>
<!-- Manifest order and elements mirror the two packages proven to install on
     this TV with the same signer: NuvioTV001 and FreeMyTVio.
     Do NOT add anything back without a proven need:
     - background-support="enable" is partner-level on tv-samsung -> [118, -4]
     - required_version > the TV platform blocks the install outright
     - the network.internet feature is declared by neither working app -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://athantv.app/tizen" version="1.1.2" viewmodes="maximized">
    <tizen:application id="AthanTV.AthanTV" package="AthanTV" required_version="2.3"/>
    <name>Athan TV</name>
    <author href="https://athantv.app">Athan TV</author>
    <description>Prayer times and adhan on your Samsung TV.</description>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
