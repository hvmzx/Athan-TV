<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://athantv.app/AthanTV"
        version="1.1.1"
        viewmodes="maximized">

    <tizen:application id="athanTv.app" package="athanTv" required_version="2.3"/>

    <content src="index.html"/>

    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/network.internet"/>

    <icon src="icon.png"/>
    <name>Athan TV</name>
    <description>Prayer times and adhan notifications on your Samsung TV.</description>
    <author href="https://athantv.app" email="contact@athantv.app">Athan TV</author>

    <access origin="*" subdomains="true"/>

    <tizen:profile name="tv-samsung"/>

    <!-- Public-level privileges only: anything the signer is not entitled to
         makes the TV refuse the package with install error [118, -4].
         filesystem.read was only needed by the removed Tizen Download transport. -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>

    <!-- background-support must stay "disable": on the tv-samsung profile an
         enabled background mode is a partner-level entitlement, and the TV
         rejects the package with install error [118, -4]. Nuvio TV and
         Free My TV both ship the widget with "disable". -->
    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"
                   hwkey-event="enable"/>
</widget>
